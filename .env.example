# .env.example — Codebase Doctor environment variables (reference only)
#
# NOTE: the MCP server does NOT load .env files. Provide these through the
# "env" block of your MCP server config (.bob/mcp.json — gitignored — or Bob's
# global MCP settings), or export them in the shell that launches Bob.

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Personal Access Token
#   Not needed to analyse / plan / migrate / verify a PUBLIC repository or a
#   local repository. Required for private repositories and for pushing the
#   migration branch + opening the pull request.
#   Classic token: `repo` scope. Fine-grained: Contents + Pull requests (read/write).
#   The token is only sent to git through the environment of the single clone /
#   push that needs it (never on the command line, never stored in .git/config).
# Create at: https://github.com/settings/tokens/new
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_YourPersonalAccessTokenHere

# ─────────────────────────────────────────────────────────────────────────────
# State directory (optional — defaults to ~/.codebase-doctor)
# Sessions live in <dir>/sessions/<uuid>/, clones in <dir>/repos/, and the
# key that seals session state in <dir>/integrity.key. Delete a session's
# folders to reclaim disk space.
# ─────────────────────────────────────────────────────────────────────────────
# CODEBASE_DOCTOR_HOME=/custom/path/.codebase-doctor

# ─────────────────────────────────────────────────────────────────────────────
# GitHub API base URL (optional — defaults to https://api.github.com).
# Used by the test suite / demo sandbox to point at a local mock.
# ─────────────────────────────────────────────────────────────────────────────
# GITHUB_API_URL=https://api.github.com

# ─────────────────────────────────────────────────────────────────────────────
# Offline mode (optional). When set to 1, the peer-dependency preflight does
# not query the npm registry (lockfile, node_modules and the curated companion
# list are still used; the report says what could not be checked).
# ─────────────────────────────────────────────────────────────────────────────
# CODEBASE_DOCTOR_OFFLINE=1

# ─────────────────────────────────────────────────────────────────────────────
# Project URL linked from generated PR bodies (optional — defaults to the
# "homepage" field in backend/package.json)
# ─────────────────────────────────────────────────────────────────────────────
# CODEBASE_DOCTOR_PROJECT_URL=https://github.com/FayazNoor/Codebase-Doctor
