# .env.example — Codebase Doctor

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Personal Access Token
# Required for: cloning private repos, creating pull requests
# Scope needed: repo (full control of private repositories)
# Create at: https://github.com/settings/tokens/new
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN

# ─────────────────────────────────────────────────────────────────────────────
# Session storage directory (optional — defaults to ~/.codebase-doctor/sessions)
# ─────────────────────────────────────────────────────────────────────────────
# SESSION_DIR=/custom/path/to/sessions

# ─────────────────────────────────────────────────────────────────────────────
# Log level (optional — defaults to "info")
# Values: debug | info | warn | error
# ─────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
